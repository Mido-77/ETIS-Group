# Copy this file to .env.local for local development.
# Vite only exposes vars prefixed with VITE_ to client-side code.

# Base URL of the FastAPI backend.
# Local dev (uvicorn running from backend/):
VITE_API_BASE_URL=http://localhost:8000

# Once hosted (Render/Railway), point this at the deployed backend, e.g.:
# VITE_API_BASE_URL=https://etis-backend.onrender.com

# Optional. Leave empty for local dev — verify_api_key no-ops when
# ETIS_API_KEY is unset on the backend, so no header is needed locally.
# Set this once the hosted backend has ETIS_API_KEY configured.
VITE_ETIS_API_KEY=
